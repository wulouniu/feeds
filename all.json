%\">\n        <div style=\"position:relative; float:right; margin:-4px;\">\n        <span typeof=\"mw:File/Frameless\"><a href=\"//en.wikivoyage.org/wiki/Previous_Destinations_of_the_Month\" title=\"Previous Destinations of the Month\"><img alt=\"DotM\" resource=\"//en.wikivoyage.org/wiki/File:Yes_Check_Circle_white.svg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/6/67/Yes_Check_Circle_white.svg/40px-Yes_Check_Circle_white.svg.png\" decoding=\"async\" data-file-width=\"20\" data-file-height=\"20\" data-file-type=\"drawing\" height=\"32\" width=\"32\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/6/67/Yes_Check_Circle_white.svg/60px-Yes_Check_Circle_white.svg.png 1.5x, //upload.wikimedia.org/wikipedia/commons/thumb/6/67/Yes_Check_Circle_white.svg/120px-Yes_Check_Circle_white.svg.png 2x\" class=\"mw-file-element\"></a></span></div>\n\t\t<section data-mw-section-id=\"-1\" id=\"mwIw\" aria-labelledby=\"Destination_of_the_Month\"><h2 style=\"font-size:1.25em;\" id=\"Destination_of_the_Month\" class=\"mw-html-heading\"><a rel=\"mw:WikiLink\" href=\"//en.wikivoyage.org/wiki/Previous_Destinations_of_the_month\" title=\"Previous Destinations of the month\">Destination of the Month</a></h2>\n        <section data-mw-section-id=\"-1\" id=\"mwJA\" aria-labelledby=\"Saint-Louis\"><h3 style=\"font-size:2em;\" id=\"Saint-Louis\" class=\"mw-html-heading\"><a rel=\"mw:WikiLink\" href=\"//en.wikivoyage.org/wiki/Saint-Louis\" title=\"Saint-Louis\">Saint-Louis</a></h3>\n\t\t<div class=\"quote\"><a rel=\"mw:WikiLink\" href=\"//en.wikivoyage.org/wiki/Saint-Louis\" title=\"Saint-Louis\">Once the colonial capital of French West Africa, Saint-Louis boasts a world heritage listed old town and lively markets and is a gateway to the Langue de Barbarie National Park.</a></div>\n\t</section></section></div>\n\t<p><span class=\"nolink\" typeof=\"mw:File/Frameless\" data-mw=\"{&quot;caption&quot;:&quot;Saint-Louis&quot;}\"><span title=\"Saint-Louis\"><img alt=\"Saint-Louis\" re